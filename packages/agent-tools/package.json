{
  "name": "@yahalla/agent-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, sandboxed project tool executors (files/git/run_command) used by both the legacy paired Device Agent and the local-first Agent Runtime.",
  "type": "module",
  "main": "./dist/index.js",
