{
  "name": "@yahalla/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Yahalla AI",
  "description": "Yahalla AI desktop shell: launches the local Agent Runtime as a child process and loads the Control Center against it. No cloud LLM, no tunnel -- this window and the AI it talks to both run on this machine.",
  "main": "src/main.cjs",
  "scripts": {
    "stage": "node scripts/stage-resources.mjs",
    "electron:dev": "npm run stage && electron .",
    "electron:build": "npm run stage && electron-builder",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "os.yahalla.desktop",
    "productName": "Yahalla AI",
    "directories": {
      "output": "dist-electron"
    },
    "publish": null,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/local-runtime",
        "to": "local-runtime"
      },
      {
        "from": "resources/app-dist",
        "to": "app-dist"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
