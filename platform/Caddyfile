# The only exposed port on the whole VPS. Terminates TLS (automatic via
# Let's Encrypt -- DOMAIN must already point at this server's IP) and
# reverse-proxies everything to platform-api. Nothing else in the compose
# stack (postgres, deploy-agent) is reachable from outside this container.
# Built from platform/caddy/Dockerfile, which adds the caddy-ratelimit
# module the stock caddy:2-alpine image doesn't ship with.

{
	order rate_limit before basicauth
}

{$DOMAIN} {
	encode gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Cheap per-IP abuse protection before requests ever reach platform-api
	# (whose own connection pool -- DB_POOL_MAX -- is the second, inner
	# line of defense against a request pileup). 120 requests/minute is
	# generous for normal Control Center use (polling health/lists) while
	# still capping a single misbehaving client well below what a
	# resource-modest VPS can take.
	rate_limit {
		zone dynamic_zone {
			key {remote_host}
			events 120
			window 1m
		}
	}

	reverse_proxy platform-api:8080
}
