<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.yahalla.llmtunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>__RUN_TUNNEL_SH__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__TUNNEL_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__TUNNEL_DIR__/logs/service.out.log</string>

  <key>StandardErrorPath</key>
  <string>__TUNNEL_DIR__/logs/service.err.log</string>
</dict>
</plist>
